SED := if os() == "linux" { "sed" } else { "gsed" }

default:
  @just --list --unsorted --color=always | rg -v "    default"

helm-update:
  cd ./deploy/helm/chart && helm dependency update

gen dest="deploy/helm/chart/otel-config.yaml":
  #!/usr/bin/env bash
  set -euo pipefail
  MERGED=$(mktemp)
  trap 'rm -f "$MERGED"' EXIT
  yq eval-all '. as $item ireduce ({}; . * $item)' \
    otel-collector-config.yaml \
    otel-collector-config-categorize.yaml \
    > "$MERGED"
  {
    echo "# This file is autogenerated via 'just gen' - do not manually edit!"
    echo "#"
    echo "opentelemetry-collector:"
    echo "  config:"
    {{SED}} 's/^/    /' "$MERGED"
  } > "{{dest}}"
  {{SED}} -i 's/[[:space:]]*$//' "{{dest}}"

check-gen:
  #!/usr/bin/env bash
  set -euo pipefail

  # Create a temporary file for the regenerated version
  TEMP_FILE=$(mktemp)
  trap "rm -f $TEMP_FILE" EXIT

  # Generate to temp file
  just gen "$TEMP_FILE"

  # Compare the files
  if ! diff -u deploy/helm/chart/otel-config.yaml "$TEMP_FILE"; then
    echo ""
    echo "Error: otel-config.yaml is not up to date!"
    echo "Please run 'just gen' and commit the changes."
    exit 1
  fi

  echo "✓ otel-config.yaml is up to date!"

gen-categorize dest="otel-collector-config-categorize.yaml":
  ./scripts/generate-categorize-rules.sh "{{dest}}"

check-gen-categorize:
  #!/usr/bin/env bash
  set -euo pipefail

  # Create a temporary file for the regenerated version
  TEMP_FILE=$(mktemp)
  trap 'rm -f "$TEMP_FILE"' EXIT

  # Generate to temp file
  just gen-categorize "$TEMP_FILE"

  # Compare the files
  if ! diff -u otel-collector-config-categorize.yaml "$TEMP_FILE"; then
    echo ""
    echo "Error: otel-collector-config-categorize.yaml is not up to date!"
    echo "Please run 'just gen-categorize' and commit the changes."
    exit 1
  fi

  echo "✓ otel-collector-config-categorize.yaml is up to date!"

test:
  bats --jobs 6 tests

# Bring up the full local demo: kind cluster, Envoy Gateway, kube-prometheus-stack,
# Loki, the collector chart, and the demo apps/routes. Uses the config already
# checked into this repo (otel-collector-config-categorize.yaml, otel-config.yaml)
# rather than regenerating it — see the "Regenerate the categorize processor"
# section of README.md if you change the demo HTTPRoutes and need to re-derive it.
demo:
  #!/usr/bin/env bash
  set -euo pipefail

  # Idempotent: safe to re-run `just demo` after a partial failure downstream
  # without needing `just demo-down` first.
  kind get clusters 2>/dev/null | grep -qx edge-metrics || \
    kind create cluster --name edge-metrics --config k8s/kind-config.yaml

  kubectl apply -f k8s/namespaces.yaml

  # Gateway API CRDs + Envoy Gateway. Pin versions here; check compatibility at
  # https://gateway.envoyproxy.io/docs/install/install-helm/ before bumping —
  # Envoy Gateway v1.9.x specifically requires Gateway API CRDs at v1.6+.
  kubectl apply -f https://github.com/kubernetes-sigs/gateway-api/releases/download/v1.6.1/standard-install.yaml
  helm upgrade --install eg oci://docker.io/envoyproxy/gateway-helm --version v1.9.1 \
    -n envoy-gateway-system --create-namespace --wait --timeout 10m
  kubectl apply -f k8s/gateway/gatewayclass.yaml

  helm repo add prometheus-community https://prometheus-community.github.io/helm-charts >/dev/null 2>&1 || true
  helm repo add grafana https://grafana.github.io/helm-charts >/dev/null 2>&1 || true
  helm repo add open-telemetry https://open-telemetry.github.io/opentelemetry-helm-charts >/dev/null 2>&1 || true
  helm repo update

  # additionalDataSources provisions Grafana's Loki datasource up front —
  # Loki doesn't need to exist yet for this (Grafana only connects when a
  # query is actually run via Explore), so install order doesn't matter here.
  helm upgrade --install kube-prom-stack prometheus-community/kube-prometheus-stack \
    -n monitoring --create-namespace \
    --set prometheus.prometheusSpec.serviceMonitorSelectorNilUsesHelmValues=false \
    --set prometheus.prometheusSpec.ruleSelectorNilUsesHelmValues=false \
    --set grafana.adminPassword=admin \
    --set grafana.additionalDataSources[0].name=Loki \
    --set grafana.additionalDataSources[0].type=loki \
    --set grafana.additionalDataSources[0].access=proxy \
    --set grafana.additionalDataSources[0].url=http://loki-gateway.monitoring.svc.cluster.local \
    --wait --timeout 10m

  # See k8s/loki-values.yaml for what each setting does and why.
  helm upgrade --install loki grafana/loki -n monitoring \
    -f k8s/loki-values.yaml \
    --wait --timeout 10m

  helm dependency update ./deploy/helm/chart
  helm upgrade --install edge-metrics ./deploy/helm/chart \
    -n edge-metrics --create-namespace \
    -f deploy/helm/chart/values.yaml \
    -f deploy/helm/chart/otel-chart-overrides.yaml \
    -f deploy/helm/chart/otel-config.yaml \
    --wait --timeout 10m

  # OBI (eBPF auto-instrumentation) — a separate, parallel telemetry path
  # from the log-derived edge metrics above. Attaches to the 5 demo
  # backends in `applications` and scrapes RED metrics directly into
  # Prometheus; does not touch the edge-metrics collector or pipeline.
  helm upgrade --install obi open-telemetry/opentelemetry-ebpf-instrumentation \
    --version 0.13.0 \
    -n obi --create-namespace \
    -f k8s/obi-values.yaml \
    --wait --timeout 10m

  kubectl apply -f k8s/gateway/gateway.yaml
  kubectl apply -f k8s/demo-app/
  kubectl apply -f k8s/kind-nodeports.yaml
  kubectl apply -f k8s/grafana/dashboards/configmap.yaml

  echo ""
  echo "Demo is up. Next: 'just demo-ui', then open http://localhost:4000"
  echo ""
  echo "  Envoy Gateway:       http://localhost:8080  (Host header set by demo-ui/curl --resolve)"
  echo "  Cloudflare receiver: http://localhost:8088"
  echo "  Grafana:             http://localhost:3000  (admin / admin)"

# Run the demo-ui relay + static frontend (http://localhost:4000). No
# port-forwarding needed — it talks to the fixed localhost ports from 'just demo'.
demo-ui:
  node demo-ui/server.mjs

demo-down:
  kind delete cluster --name edge-metrics